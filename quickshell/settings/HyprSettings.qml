pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io

// Holds every editable value, writes ~/.config/hypr/settings.conf,
// and applies the values live with `hyprctl --batch keyword ...`.
Singleton {
    id: root

    property int gapsIn: 5
    property int gapsOut: 10
    property int borderSize: 2
    property int rounding: 10

    property string activeA: "33ccff"
    property string activeB: "00ff99"
    property string inactive: "595959"
    property int angle: 45

    property real activeOpacity: 1.0
    property real inactiveOpacity: 1.0
    property bool blurEnabled: true
    property int blurSize: 8
    property int blurPasses: 1
    property bool shadowEnabled: true
    property bool animationsEnabled: true

    readonly property string confPath: Quickshell.env("HOME") + "/.config/hypr/settings.conf"
    readonly property var keys: [
        "gapsIn", "gapsOut", "borderSize", "rounding",
        "activeA", "activeB", "inactive", "angle",
        "activeOpacity", "inactiveOpacity", "blurEnabled", "blurSize",
        "blurPasses", "shadowEnabled", "animationsEnabled"
    ]
    property var saved: ({})

    function snapshot() {
        var s = {};
        for (var i = 0; i < keys.length; i++) s[keys[i]] = root[keys[i]];
        saved = s;
    }

    function revert() {
        for (var i = 0; i < keys.length; i++)
            if (saved[keys[i]] !== undefined) root[keys[i]] = saved[keys[i]];
    }

    function load() { reader.running = true; }

    function rgba(c, a) { return "rgba(" + c + a + ")"; }

    function confText() {
        var L = [];
        L.push("# Generated by the Quickshell settings app (overwritten on Apply)");
        L.push("general {");
        L.push("    gaps_in = " + gapsIn);
        L.push("    gaps_out = " + gapsOut);
        L.push("    border_size = " + borderSize);
        L.push("    col.active_border = " + rgba(activeA, "ee") + " " + rgba(activeB, "ee") + " " + angle + "deg");
        L.push("    col.inactive_border = " + rgba(inactive, "aa"));
        L.push("}");
        L.push("decoration {");
        L.push("    rounding = " + rounding);
        L.push("    active_opacity = " + activeOpacity.toFixed(2));
        L.push("    inactive_opacity = " + inactiveOpacity.toFixed(2));
        L.push("    blur {");
        L.push("        enabled = " + blurEnabled);
        L.push("        size = " + blurSize);
        L.push("        passes = " + blurPasses);
        L.push("    }");
        L.push("    shadow {");
        L.push("        enabled = " + shadowEnabled);
        L.push("    }");
        L.push("}");
        L.push("animations {");
        L.push("    enabled = " + animationsEnabled);
        L.push("}");
        return L.join("\n");
    }

    function batchText() {
        return [
            "keyword general:gaps_in " + gapsIn,
            "keyword general:gaps_out " + gapsOut,
            "keyword general:border_size " + borderSize,
            "keyword general:col.active_border " + rgba(activeA, "ee") + " " + rgba(activeB, "ee") + " " + angle + "deg",
            "keyword general:col.inactive_border " + rgba(inactive, "aa"),
            "keyword decoration:rounding " + rounding,
            "keyword decoration:active_opacity " + activeOpacity.toFixed(2),
            "keyword decoration:inactive_opacity " + inactiveOpacity.toFixed(2),
            "keyword decoration:blur:enabled " + blurEnabled,
            "keyword decoration:blur:size " + blurSize,
            "keyword decoration:blur:passes " + blurPasses,
            "keyword decoration:shadow:enabled " + shadowEnabled,
            "keyword animations:enabled " + animationsEnabled
        ].join(" ; ");
    }

    function apply() {
        snapshot();
        writer.command = ["sh", "-c",
            'mkdir -p "$(dirname "$2")" && printf "%s\\n" "$1" > "$2"',
            "sh", confText(), confPath];
        writer.running = true;
        live.command = ["hyprctl", "--batch", batchText()];
        live.running = true;
    }

    function parse(text) {
        if (!text || text.trim() === "") { snapshot(); return; }

        var stack = [], map = {};
        var lines = text.split("\n");
        for (var i = 0; i < lines.length; i++) {
            var t = lines[i].trim();
            if (t === "" || t[0] === "#") continue;
            if (t[t.length - 1] === "{") stack.push(t.slice(0, -1).trim());
            else if (t === "}") stack.pop();
            else {
                var eq = t.indexOf("=");
                if (eq < 0) continue;
                map[stack.concat([t.slice(0, eq).trim()]).join(":")] = t.slice(eq + 1).trim();
            }
        }

        function getNum(k, d) { var v = parseFloat(map[k]); return isNaN(v) ? d : v; }
        function getBool(k, d) {
            if (map[k] === undefined) return d;
            return ["true", "yes", "on", "1"].indexOf(map[k]) >= 0;
        }

        gapsIn = getNum("general:gaps_in", gapsIn);
        gapsOut = getNum("general:gaps_out", gapsOut);
        borderSize = getNum("general:border_size", borderSize);
        rounding = getNum("decoration:rounding", rounding);
        activeOpacity = getNum("decoration:active_opacity", activeOpacity);
        inactiveOpacity = getNum("decoration:inactive_opacity", inactiveOpacity);
        blurEnabled = getBool("decoration:blur:enabled", blurEnabled);
        blurSize = getNum("decoration:blur:size", blurSize);
        blurPasses = getNum("decoration:blur:passes", blurPasses);
        shadowEnabled = getBool("decoration:shadow:enabled", shadowEnabled);
        animationsEnabled = getBool("animations:enabled", animationsEnabled);

        var re = /rgba\(([0-9a-fA-F]{6})[0-9a-fA-F]{2}\)/g, m, cols = [];
        var a = map["general:col.active_border"];
        if (a) {
            while ((m = re.exec(a)) !== null) cols.push(m[1].toLowerCase());
            if (cols.length > 0) activeA = cols[0];
            if (cols.length > 1) activeB = cols[1];
            var ang = /(\d+)deg/.exec(a);
            if (ang) angle = parseInt(ang[1]);
        }
        var inact = map["general:col.inactive_border"];
        if (inact) {
            re.lastIndex = 0;
            m = re.exec(inact);
            if (m) inactive = m[1].toLowerCase();
        }
        snapshot();
    }

    Component.onCompleted: load()

    Process {
        id: reader
        command: ["sh", "-c", 'cat "$1" 2>/dev/null', "sh", root.confPath]
        stdout: StdioCollector { onStreamFinished: root.parse(text) }
    }
    Process { id: writer }
    Process { id: live }
}
